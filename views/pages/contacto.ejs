<%- include('../partials/head') %><%- include('../partials/header') %><main><section class="page-hero"><div class="container"><p class="eyebrow">CONTACTO</p><h1>Conversemos sobre tu proyecto.</h1><p>Contanos qué necesitás y nos pondremos en contacto.</p></div></section><section class="section"><div class="container contact-layout"><div><h2>Solicitud de servicio</h2><% if(errores.general){ %><p class="form-error" role="alert"><%= errores.general %></p><% } %><form method="post" action="/contacto" class="contact-form" novalidate><div class="honeypot" aria-hidden="true"><label for="website">No completar</label><input id="website" name="website" tabindex="-1" autocomplete="off"></div><div class="form-grid"><div class="field"><label for="nombre">Nombre y apellido *</label><input id="nombre" name="nombre" value="<%= datos.nombre||'' %>" required maxlength="150"><small><%= errores.nombre||'' %></small></div><div class="field"><label for="empresa">Empresa</label><input id="empresa" name="empresa" value="<%= datos.empresa||'' %>" maxlength="180"></div><div class="field"><label for="cargo">Cargo</label><input id="cargo" name="cargo" value="<%= datos.cargo||'' %>" maxlength="120"></div><div class="field"><label for="email">Correo electrónico *</label><input id="email" type="email" name="email" value="<%= datos.email||'' %>" required><small><%= errores.email||'' %></small></div><div class="field"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" value="<%= datos.telefono||'' %>"></div><div class="field"><label for="servicio">Servicio de interés *</label><select id="servicio" name="servicio" required><option value="">Seleccioná una opción</option><% servicios.forEach(s=>{ %><option value="<%= s.slug %>" <%= datos.servicio===s.slug?'selected':'' %>><%= s.titulo %></option><% }) %><option value="otro" <%= datos.servicio==='otro'?'selected':'' %>>Otro</option></select><small><%= errores.servicio||'' %></small></div><div class="field"><label for="tipo_activo">Tipo de activo</label><select id="tipo_activo" name="tipo_activo"><% [['','Seleccioná'],['eolico','Eólico'],['solar','Solar'],['hibrido','Híbrido'],['subestacion','Subestación'],['otro','Otro']].forEach(([v,t])=>{ %><option value="<%= v %>" <%= datos.tipo_activo===v?'selected':'' %>><%= t %></option><% }) %></select><small><%= errores.tipo_activo||'' %></small></div><div class="field"><label for="ubicacion">Ubicación del parque</label><input id="ubicacion" name="ubicacion" value="<%= datos.ubicacion||'' %>" placeholder="Departamento o país"></div><div class="field"><label for="capacidad_mw">Capacidad aproximada (MW)</label><input id="capacidad_mw" name="capacidad_mw" type="number" min="0" max="100000" step="any" value="<%= datos.capacidad_mw||'' %>"><small><%= errores.capacidad_mw||'' %></small></div></div><div class="field"><label for="mensaje">Mensaje *</label><textarea id="mensaje" name="mensaje" rows="6" required maxlength="5000"><%= datos.mensaje||'' %></textarea><small><%= errores.mensaje||'' %></small></div><label class="check-label"><input type="checkbox" name="privacidad" value="si" <%= datos.privacidad==='si'?'checked':'' %> required><span>Acepto la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a> *</span></label><small class="form-error"><%= errores.privacidad||'' %></small><button class="btn" type="submit">Enviar solicitud <span aria-hidden="true">↗</span></button></form></div><aside class="contact-aside"><p class="eyebrow">OTRAS VÍAS</p><h3>Estamos en Montevideo, Uruguay.</h3><p>Correo: <a href="mailto:<%= site.email %>"><%= site.email %></a></p><p>Teléfono: <%= site.telefono %></p><% if(site.whatsapp){ %><p><a href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener noreferrer">WhatsApp</a></p><% } %><% if(site.linkedin){ %><p><a href="<%= site.linkedin %>" target="_blank" rel="noopener noreferrer">LinkedIn</a></p><% } %><img src="/img/parque-atardecer.jpg" alt="Parque eólico al atardecer" loading="lazy"></aside></div></section></main><%- include('../partials/footer') %>
