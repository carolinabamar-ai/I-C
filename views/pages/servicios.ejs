<%- include('../partials/head') %><%- include('../partials/header') %>
<main><section class="section services-heading"><div class="container center"><p class="eyebrow">SERVICIOS</p><h1>Nuestros servicios</h1><p>Ingeniería aplicada al rendimiento, la seguridad y la vida útil de cada activo.</p></div></section>
<section class="section services-interactive-section"><div class="container services-interactive" data-service-browser><div class="service-picker" role="group" aria-label="Seleccionar servicio"><% servicios.forEach((s,i)=>{ %><button type="button" class="service-option <%= i===0?'selected':'' %>" data-service-select="<%= s.slug %>" aria-pressed="<%= i===0?'true':'false' %>"><span class="service-option-number"><%= String(i+1).padStart(2,'0') %></span><span><%= s.titulo %></span><span class="service-option-arrow" aria-hidden="true">↗</span></button><% }) %></div><div class="service-display" aria-live="polite"><% servicios.forEach((s,i)=>{ %><article id="<%= s.slug %>" class="service-panel" data-service-panel="<%= s.slug %>" <%- i===0?'':'hidden' %>><img src="/img/<%= s.foto %>" alt="Parque eólico, fotografía original de Ingeniería y Consciencia" loading="<%= i===0?'eager':'lazy' %>"><div class="service-panel-copy"><p class="eyebrow"><%= String(i+1).padStart(2,'0') %> / 09</p><h2><%= s.titulo %></h2><p><%= s.descripcion %></p><a class="text-link" href="/contacto?servicio=<%= s.slug %>">Consultar por este servicio <span aria-hidden="true">↗</span></a></div></article><% }) %></div></div></section></main><%- include('../partials/footer') %>