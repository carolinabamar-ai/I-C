<%- include('../partials/head') %><%- include('../partials/header') %><main><section class="page-hero"><div class="container"><p class="eyebrow">SERVICIOS</p><h1>Soluciones técnicas para cuidar el rendimiento de tus activos.</h1><p>Asesoramiento independiente, experiencia en campo y análisis para decisiones de largo plazo.</p></div></section><section class="section"><div class="container"><% servicios.forEach((s,i)=>{ %><article class="service-detail reveal" id="<%= s.slug %>"><div class="service-detail-text"><p class="eyebrow"><%= String(i+1).padStart(2,'0') %> / 09</p><h2><%= s.titulo %></h2><p><%= s.descripcion %></p><a class="text-link" href="/contacto?servicio=<%= s.slug %>">Consultar por este servicio <span aria-hidden="true">↗</span></a></div><img src="/img/<%= s.foto %>" alt="Fotografía de parque eólico relacionada con <%= s.titulo %>" loading="lazy"></article><% }) %></div></section></main><%- include('../partials/footer') %>
