<%- include('../partials/head') %><main class="section admin"><div class="container"><p class="eyebrow">PANEL INTERNO</p><h1>Solicitudes recibidas</h1><p><a class="btn" href="/admin/solicitudes.csv">Exportar CSV</a> <a href="/">Volver al sitio</a></p><div class="table-scroll"><table><thead><tr><th>Fecha</th><th>Nombre</th><th>Empresa</th><th>Correo</th><th>Servicio</th><th>Mensaje</th><th>Estado</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><%= new Date(r.created_at).toLocaleString('es-UY') %></td><td><%= r.nombre %></td><td><%= r.empresa||'-' %></td><td><a href="mailto:<%= r.email %>"><%= r.email %></a></td><td><%= r.servicio %></td><td><%= r.mensaje %></td><td><form method="post" action="/admin/solicitudes/<%= r.id %>/estado"><select name="estado" aria-label="Estado de solicitud <%= r.id %>"><% estados.forEach(e=>{ %><option value="<%= e %>" <%= r.estado===e?'selected':'' %>><%= e %></option><% }) %></select><button type="submit">Guardar</button></form></td></tr><% }) %></tbody></table></div><% if(!rows.length){ %><p>No hay solicitudes todavía.</p><% } %></div></main><%- include('../partials/footer') %>
